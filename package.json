{
  "name": "campusos",
  "version": "1.0.0",
  "description": "CampusOS - AI-powered university platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seed.js",
    "db:inspect": "node scripts/inspect-db.js",
